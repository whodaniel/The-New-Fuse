{
  "name": "@the-new-fuse/agent-adapters",
  "version": "0.1.0",
  "description": "Agent interoperability adapters for The New Fuse — stateless translators between TNF Envelope Protocol and external agent runtimes (Google Agents CLI, etc.)",
  "files": [
    "dist",
    "README.md"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc --watch",
    "clean": "rm -rf dist *.tsbuildinfo",
    "type-check": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write \"**/*.{ts,json,md}\""
  },
  "devDependencies": {
    "@types/node": "^24.8.1",
    "typescript": "^6.0.2",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "agent-adapters",
    "google-agents-cli",
    "json-rpc",
    "tnf-envelope",
    "interoperability",
    "the-new-fuse"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/the-new-fuse/the-new-fuse.git",
    "directory": "packages/agent-adapters"
  },
  "author": {
    "name": "The New Fuse Team",
    "url": "https://github.com/the-new-fuse"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "sideEffects": false
}
