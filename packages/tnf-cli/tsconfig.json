{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "composite": true,
    "declaration": true,
    "baseUrl": ".",
    "paths": {
      "@the-new-fuse/tnf-core": ["../tnf-core/src/index.ts"],
      "@the-new-fuse/tnf-core/*": ["../tnf-core/src/*"],
      "@the-new-fuse/tnf-note-taking": ["../tnf-note-taking/src/index.ts"],
      "@the-new-fuse/tnf-note-taking/*": ["../tnf-note-taking/src/*"],
      "@the-new-fuse/infrastructure": ["../infrastructure/src/index.ts"],
      "@the-new-fuse/infrastructure/*": ["../infrastructure/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
