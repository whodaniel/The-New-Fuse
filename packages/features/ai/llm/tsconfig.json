{
  "extends": "../../../../tsconfig.base.json",
  "compilerOptions": {
    "moduleResolution": "bundler",
    "module": "ESNext",
    "outDir": "./dist",
    "rootDir": ".",
    "composite": true,
    "types": [
      "react",
      "node",
      "jest"
    ],
    "declaration": true,
    "declarationMap": true,
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "src*",
    "components*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "***.spec.ts"
  ],
  "references": [
    {
      "path": "../../../core"
    },
    {
      "path": "../../../types"
    }
  ]
}
