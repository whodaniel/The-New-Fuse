{
  "name": "@the-new-fuse/control-plane-contracts",
  "version": "1.0.0",
  "description": "Public TypeScript contracts for TNF proprietary control-plane components (Master Clock, Broker Agent). Safe to ship in The-New-Fuse.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types@build": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "dev": "tsc -b --watch",
    "type-check": "tsc --noEmit",
    "test": "pnpm run build && node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "typescript": "^6.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
