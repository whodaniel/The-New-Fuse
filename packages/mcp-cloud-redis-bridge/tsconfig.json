{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "composite": true,
    "types": [
      "node"
    ],
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "src*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts"
  ]
}
