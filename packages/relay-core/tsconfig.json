{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "strict": false,
    "noImplicitAny": false,
    "strictFunctionTypes": false,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "rootDir": ".",
    "declaration": true,
    "composite": true,
    "types": [
      "node"
    ],
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "paths": {
      "@the-new-fuse/infrastructure": [
        "../infrastructure/dist"
      ],
      "@the-new-fuse/database": [
        "../database/dist"
      ],
      "@the-new-fuse/types": [
        "../types/dist"
      ],
      "@the-new-fuse/tnf-cli": [
        "../tnf-cli/dist"
      ]
    },
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "src*",
    "../tnf-cli/src*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "***.spec.ts"
  ],
  "references": []
}
