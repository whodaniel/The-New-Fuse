{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "jest"
    ],
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "src*"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "***.spec.ts"
  ]
}
