{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "rootDir": "./src",
    "module": "ESNext",
    "declaration": true,
    "composite": true,
    "paths": {
      "@the-new-fuse/types": [
        "../../packages/types/src"
      ]
    },
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "src*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "***.spec.ts"
  ]
}
