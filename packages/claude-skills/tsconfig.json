{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "moduleResolution": "bundler",
    "module": "ESNext",
    "outDir": "dist",
    "rootDir": "src",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "src*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "***.spec.ts"
  ],
  "references": [
    {
      "path": "../mcp-core"
    },
    {
      "path": "../core-error-handling"
    },
    {
      "path": "../core-monitoring"
    }
  ]
}
