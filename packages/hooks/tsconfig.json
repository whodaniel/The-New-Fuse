{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "composite": true,
    "noEmit": false,
    "jsx": "react-jsx",
    "types": [
      "jest",
      "node",
      "react"
    ],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true,
    "noImplicitAny": false,
    "strict": false,
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "src*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "***.spec.ts",
    "***.spec.tsx"
  ],
  "references": [
    {
      "path": "../api-client"
    },
    {
      "path": "../fairtable-core"
    },
    {
      "path": "../types"
    }
  ]
}
