{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "composite": true,
    "allowJs": true,
    "checkJs": false,
    "resolveJsonModule": true,
    "module": "ESNext",
    "target": "ES2022",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "strict": false,
    "noImplicitAny": false,
    "types": [
      "jest",
      "node"
    ],
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "src*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "***.spec.ts",
    "src/test-db.ts"
  ],
  "references": [
    {
      "path": "../../packages/types"
    }
  ]
}
