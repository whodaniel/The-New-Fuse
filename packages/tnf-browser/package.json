{
  "name": "@the-new-fuse/tnf-browser",
  "version": "1.0.0",
  "description": "TNF browser control framework for agents via Chrome extension + WebSocket",
  "main": "index.js",
  "bin": {
    "tnf-browser": "bin/cli.js"
  },
  "files": [
    "index.js",
    "lib/",
    "client/",
    "extension/",
    "bin/",
    "protocol/PROTOCOL.md",
    "tnf-browser.config.example.js",
