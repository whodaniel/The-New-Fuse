{
  "compilerOptions": {
    "moduleResolution": "NodeNext",
    "target": "es2020",
    "module": "NodeNext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "composite": true,
    "declaration": true,
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "./test",
    "./scripts",
    "./hardhat.config.js"
  ],
  "exclude": [
    "node_modules"
  ]
}
