# TNF WhatsApp Bot Configuration
# Copy this to .env.tnf-whatsapp and fill in your values.
#
# To set up WhatsApp Cloud API:
#   1. Go to https://developers.facebook.com → Create App → Business type
#   2. Add WhatsApp product
#   3. Set up a test phone number under WhatsApp → Getting Started
#   4. Generate a permanent access token under System Users
#   5. Configure your webhook URL for incoming messages

# WhatsApp Cloud API Access Token
TNF_WHATSAPP_TOKEN=

# Phone Number ID (from WhatsApp → Getting Started)
TNF_WHATSAPP_PHONE_ID=

# Webhook Verify Token (you choose this, must match Meta webhook config)
TNF_WHATSAPP_VERIFY_TOKEN=tnf-webhook-verify

# Webhook port (default 3001 to avoid relay conflict on 3000)
TNF_WHATSAPP_WEBHOOK_PORT=3001
