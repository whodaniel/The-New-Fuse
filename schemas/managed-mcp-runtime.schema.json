{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thenewfuse.com/schemas/managed-mcp-runtime.schema.json",
  "title": "TNF managed MCP runtime",
  "type": "object",
  "required": ["schemaVersion", "runtimeRoot", "packages", "hostPolicy"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runtimeRoot": { "type": "string", "minLength": 1 },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "version", "bin", "wrapper", "integrity"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
          },
          "bin": { "type": "string", "minLength": 1 },
          "wrapper": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "integrity": { "type": "string", "pattern": "^sha512-" },
          "secret": {
            "type": "object",
            "required": [
              "provider",
              "service",
              "accountEnv",
              "environmentVariable"
            ],
            "properties": {
              "provider": { "const": "macos-keychain" },
              "service": { "type": "string", "minLength": 1 },
              "accountEnv": { "type": "string", "minLength": 1 },
              "environmentVariable": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "hostPolicy": {
      "type": "object",
      "required": [
        "forbiddenRuntimeCommands",
        "forbiddenVersionTags",
        "retiredServers"
      ],
      "properties": {
        "forbiddenRuntimeCommands": {
          "type": "array",
          "items": { "type": "string" }
        },
        "forbiddenVersionTags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "retiredServers": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
