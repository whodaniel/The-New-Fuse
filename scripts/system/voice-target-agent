#!/bin/bash
# voice-target-agent: Lock transcription inject to the tty running cursor-agent / tnf agent.
set -euo pipefail

_SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=voicebridge-paths.sh
source "$_SCRIPT_DIR/voicebridge-paths.sh"

press_enter=1
quiet=0
profile="${VOICEBRIDGE_PROFILE:-main}"
prefer=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --profile)
      profile="${2:-}"
      if [[ -z "$profile" ]]; then
        echo "Missing value for --profile" >&2
        exit 1
      fi
      shift 2
      ;;
    --enter)
      press_enter=1
      shift
      ;;
    --no-enter)
      press_enter=0
      shift
      ;;
    --quiet)
      quiet=1
      shift
      ;;
    --prefer)
      prefer="${2:-}"
      if [[ -z "$prefer" ]]; then
        echo "Missing value for --prefer" >&2
        exit 1
      fi
      shift 2
      ;;
    *)
      echo "Usage: voice-target-agent [--profile A|B|...] [--enter|--no-enter] [--prefer cursor-agent|tnf] [--quiet]" >&2
      exit 1
      ;;
  esac
done

if command -v voicebridge_use_profile >/dev/null 2>&1; then
  voicebridge_use_profile "$profile"
fi
VOICEBRIDGE_STATE_DIR="${VOICEBRIDGE_STATE_DIR:-$HOME/.voicebridge}"
mkdir -p "$VOICEBRIDGE_STATE_DIR"
if command -v voicebridge_init_state >/dev/null 2>&1; then
  voicebridge_init_state
fi

if command -v voicebridge_state_file >/dev/null 2>&1; then
  TARGET_JSON="$(voicebridge_state_file "voice_target.json")"
  TARGET_TTY_FILE="$(voicebridge_state_file "voice_target_tty")"
else
  TARGET_JSON="$VOICEBRIDGE_STATE_DIR/voice_target.json"
  TARGET_TTY_FILE="$VOICEBRIDGE_STATE_DIR/voice_target_tty"
fi

FOUND="$(
  PREFER="$prefer" python3 - <<'PY'
import os
import re
import subprocess

prefer = (os.environ.get("PREFER") or "").strip().lower()

# Patterns ordered by preference for chat-agent destinations.
patterns = [
    ("cursor-agent", re.compile(r"(^|[/\s])cursor-agent([/\s]|$)")),
    ("cursor-agent", re.compile(r"\.local/share/cursor-agent/")),
    ("tnf-agent", re.compile(r"tnf-agent-daemon|tnf agent |packages/tnf-cli.*\bagent\b")),
]

if prefer in {"cursor", "cursor-agent"}:
    patterns = [p for p in patterns if p[0] == "cursor-agent"] + [p for p in patterns if p[0] != "cursor-agent"]
elif prefer in {"tnf", "tnf-agent"}:
    patterns = [p for p in patterns if p[0] == "tnf-agent"] + [p for p in patterns if p[0] != "tnf-agent"]

try:
    out = subprocess.check_output(["ps", "axo", "pid=,tty=,command="], text=True, stderr=subprocess.DEVNULL)
except Exception:
    raise SystemExit(1)

candidates = []
for line in out.splitlines():
    line = line.strip()
    if not line:
        continue
    parts = line.split(None, 2)
    if len(parts) < 3:
        continue
    pid_s, tty, cmd = parts
    if not tty or tty == "??" or tty == "-":
        continue
    tty = tty.replace("/dev/", "")
    lower = cmd.lower()
    if "voice-target-agent" in lower or "pgrep" in lower:
        continue
    for label, rx in patterns:
        if rx.search(cmd):
            try:
                pid = int(pid_s)
            except ValueError:
                pid = 0
            candidates.append((label, tty, pid, cmd[:160]))
            break

if not candidates:
    raise SystemExit(2)

# Prefer highest pid (most recently started) within the best label order.
best_label = candidates[0][0]
ranked = [c for c in candidates if c[0] == best_label] or candidates
ranked.sort(key=lambda c: c[2], reverse=True)
label, tty, pid, cmd = ranked[0]
print(f"{label}\t{tty}\t{pid}\t{cmd}")
PY
)" || {
  code=$?
  if [[ "$code" -eq 2 ]]; then
    echo "❌ No cursor-agent / tnf agent process found on a tty." >&2
    echo "   Start the agent in Terminal, then re-run: voice-target-agent" >&2
  else
    echo "❌ Failed to scan processes for agent tty." >&2
  fi
  exit 1
}

label="$(printf '%s\n' "$FOUND" | awk -F'\t' 'NR==1{print $1}')"
target_tty="$(printf '%s\n' "$FOUND" | awk -F'\t' 'NR==1{print $2}')"
agent_pid="$(printf '%s\n' "$FOUND" | awk -F'\t' 'NR==1{print $3}')"

printf '%s\n' "$target_tty" > "$TARGET_TTY_FILE"

LABEL="$label" TTY_VALUE="$target_tty" AGENT_PID="$agent_pid" PRESS_ENTER="$press_enter" TARGET_JSON="$TARGET_JSON" python3 - <<'PY'
import json
import os
import time

payload = {
    "kind": "terminal",
    "tty": os.environ["TTY_VALUE"],
    "press_enter": os.environ.get("PRESS_ENTER", "1") == "1",
    "app": os.environ.get("LABEL", "agent"),
    "agent_pid": int(os.environ.get("AGENT_PID") or "0"),
    "locked": True,
    "lock_reason": "voice-target-agent",
    "updated_at": int(time.time()),
}
with open(os.environ["TARGET_JSON"], "w", encoding="utf-8") as f:
    json.dump(payload, f, indent=2)
    f.write("\n")
PY

if [[ "$quiet" -eq 1 ]]; then
  printf '%s\n' "$target_tty"
  exit 0
fi

enter_label="ON"
if [[ "$press_enter" -eq 0 ]]; then
  enter_label="OFF"
fi

echo "🎯 [${VOICEBRIDGE_PROFILE}] Transcription destination locked to ${label} on ${target_tty} (pid ${agent_pid}, Enter: ${enter_label})"
