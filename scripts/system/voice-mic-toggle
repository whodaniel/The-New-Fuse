#!/bin/bash
# Pause or resume the voice beam (mic capture + injection). Default: toggle.
set -euo pipefail

_SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=voicebridge-paths.sh
source "$_SCRIPT_DIR/voicebridge-paths.sh"
profile="${VOICEBRIDGE_PROFILE:-main}"
mode="toggle"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --profile)
      profile="${2:-}"
      if [[ -z "$profile" ]]; then
        echo "Missing value for --profile" >&2
        exit 1
      fi
      shift 2
      ;;
    --profile=*)
      profile="${1#--profile=}"
      if [[ -z "$profile" ]]; then
        echo "Missing value for --profile" >&2
        exit 1
      fi
      shift
      ;;
    --pause|--off)
      mode="pause"
      shift
      ;;
    --resume|--on)
      mode="resume"
      shift
      ;;
    --status)
      mode="status"
      shift
      ;;
    *)
      echo "Usage: voice-mic-toggle [--profile NAME] [--pause|--resume|--status]" >&2
      exit 1
      ;;
  esac
done

if command -v voicebridge_use_profile >/dev/null 2>&1; then
  voicebridge_use_profile "$profile"
fi
VOICEBRIDGE_STATE_DIR="${VOICEBRIDGE_STATE_DIR:-$HOME/.voicebridge}"
mkdir -p "$VOICEBRIDGE_STATE_DIR"
if command -v voicebridge_init_state >/dev/null 2>&1; then
  voicebridge_init_state
fi

if command -v voicebridge_state_file >/dev/null 2>&1; then
  MIC_FILE="$(voicebridge_state_file "voice_mic_paused")"
else
  MIC_FILE="$VOICEBRIDGE_STATE_DIR/voice_mic_paused"
fi

beam_paused() {
  [[ -f "$MIC_FILE" ]]
}

pause_beam() {
  touch "$MIC_FILE"
  echo "⏸️  [${VOICEBRIDGE_PROFILE}] Beam paused (mic + injection idle)"
}

resume_beam() {
  rm -f "$MIC_FILE"
  echo "▶️  [${VOICEBRIDGE_PROFILE}] Beam active"
}

case "$mode" in
  pause)
    pause_beam
    ;;
  resume)
    resume_beam
    ;;
  status)
    if beam_paused; then
      echo "paused"
      exit 0
    fi
    echo "active"
    exit 0
    ;;
  toggle)
    if beam_paused; then
      resume_beam
    else
      pause_beam
    fi
    ;;
esac
