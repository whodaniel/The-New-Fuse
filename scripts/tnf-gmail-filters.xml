  <!-- Filter 1: TNF Directives -->
  <entry>
    <category term='filter'></category>
    <title>Mail Filter: TNF Directives</title>
    <apps:property name='from' value='bizsynth@gmail.com'/>
    <apps:property name='to' value='bizsynth@gmail.com'/>
    <apps:property name='hasTheWord' value='subject:(Directives OR "TNF: Directives" OR "[TNF: Directives]" OR "TNF Directives")'/>
    <apps:property name='label' value='TNF/Directives'/>
    <apps:property name='shouldStar' value='true'/>
    <apps:property name='shouldAlwaysMarkAsImportant' value='true'/>
  </entry>

