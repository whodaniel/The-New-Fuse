#!/bin/bash
# Complete automated deployment to Cloudflare
# This script will deploy and configure all services

set -e

PROJECT_ID="041cee9d-8648-4074-b5a6-0eae436de1d1"
ENV_ID="f706eaae-de9e-4a9b-a970-944dd4a6be41"
JWT_SECRET="your-jwt-secret-from-env"

echo "========================================="
echo "Automated Cloudflare Deployment"
echo "========================================="
echo ""

cd /path/to/Desktop/A1-Inter-LLM-Com/The-New-Fuse

# Deploy API
echo "Deploying API service..."
cd apps/api
export CLOUDFLARE_PROJECT_ID=$PROJECT_ID
export CLOUDFLARE_ENVIRONMENT_ID=$ENV_ID
cloudflare up --service api --detach || cloudflare up --detach &
API_PID=$!
cd ../..

# Deploy Backend
echo "Deploying Backend service..."
cd apps/backend
export CLOUDFLARE_PROJECT_ID=$PROJECT_ID
export CLOUDFLARE_ENVIRONMENT_ID=$ENV_ID
cloudflare up --service backend --detach || cloudflare up --detach &
BACKEND_PID=$!
cd ../..

# Deploy API Gateway
echo "Deploying API Gateway service..."
cd apps/api-gateway
export CLOUDFLARE_PROJECT_ID=$PROJECT_ID
export CLOUDFLARE_ENVIRONMENT_ID=$ENV_ID
cloudflare up --service api-gateway --detach || cloudflare up --detach &
GATEWAY_PID=$!
cd ../..

# Deploy Frontend
echo "Deploying Frontend service..."
cd apps/frontend
export CLOUDFLARE_PROJECT_ID=$PROJECT_ID
export CLOUDFLARE_ENVIRONMENT_ID=$ENV_ID
cloudflare up --service frontend --detach || cloudflare up --service "Frontend Application" --detach &
FRONTEND_PID=$!
cd ../..

echo ""
echo "All deployments initiated!"
echo "Builds will take 40-60 minutes."
echo ""
echo "Monitor with:"
echo "  cloudflare logs --service api"
echo "  cloudflare logs --service backend"
echo "  cloudflare logs --service api-gateway"
echo "  cloudflare logs --service frontend"
echo ""
