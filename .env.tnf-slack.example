# TNF Slack Bot Configuration
# Copy this to .env.tnf-slack and fill in your values.
#
# To create a Slack app:
#   1. Go to https://api.slack.com/apps → Create New App
#   2. Enable Socket Mode under "Socket Mode"
#   3. Add Bot Token Scopes: chat:write, channels:history, groups:history, im:history, mpim:history
#   4. Install to your workspace
#   5. Copy the tokens below

# Bot User OAuth Token (starts with xoxb-)
TNF_SLACK_BOT_TOKEN=

# Signing Secret (from Basic Information → App Credentials)
TNF_SLACK_SIGNING_SECRET=

# App-Level Token for Socket Mode (starts with xapp-)
TNF_SLACK_APP_TOKEN=
