{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thenewfuse.com/schemas/tnf-session-handoff.schema.json",
  "title": "TNF Session Handoff",
  "description": "Canonical machine-readable handoff artifact for repository-aware, capability-first TNF session continuity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec",
    "handoff_id",
    "created_at",
    "repository",
    "repository_context",
    "branch",
    "head_sha",
    "protocol_ack",
    "sensitive_scope",
    "classification",
    "capabilities",
    "publication",
    "freshness_receipts",
    "work_summary",
    "changed_paths",
    "verification",
    "continuation",
    "next_actions"
  ],
  "properties": {
    "spec": {
      "type": "string",
      "description": "Protocol spec. 0.3 adds individually-addressable registry fields (session, checkout, task, supersession, acceptance); 0.2 artifacts remain valid.",
      "enum": [
        "tnf/session-handoff/0.2",
        "tnf/session-handoff/0.3"
      ]
    },
    "handoff_id": {
      "type": "string",
      "format": "uuid"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "repository_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_source",
        "actual",
        "publication_targets"
      ],
      "properties": {
        "canonical_source": {
          "type": "string",
          "const": "whodaniel/tnf-monorepo"
        },
        "actual": {
          "type": "string",
          "minLength": 1
        },
        "origin": {
          "type": "string"
        },
        "dirty": {
          "type": "boolean"
        },
        "operation_in_progress": {
          "type": [
            "string",
            "null"
          ]
        },
        "publication_targets": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "whodaniel/The-New-Fuse",
              "whodaniel/fuse-control-plane"
            ]
          },
          "uniqueItems": true
        }
      }
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "head_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "protocol_ack": {
      "type": "string",
      "const": "TNF_PROTOCOL_ACK"
    },
    "sensitive_scope": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "private",
        "restricted"
      ]
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work_domain",
        "artifact_destination",
        "data_residency",
        "sensitivity"
      ],
      "properties": {
        "work_domain": {
          "type": "string",
          "enum": [
            "core",
            "agency",
            "personal",
            "unknown"
          ]
        },
        "artifact_destination": {
          "type": "string",
          "enum": [
            "oss_runtime",
            "public_contract",
            "private_control_plane",
            "satellite",
            "external",
            "unknown"
          ]
        },
        "data_residency": {
          "type": "string",
          "enum": [
            "product_state",
            "bounded_working",
            "external_durable",
            "secret_machine_local",
            "unknown"
          ]
        },
        "sensitivity": {
          "type": "string",
          "enum": [
            "public",
            "internal",
            "private",
            "restricted",
            "unknown"
          ]
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "staffed_by"
      ],
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "staffed_by": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "public_runtime_affected",
        "control_plane_affected",
        "satellites"
      ],
      "properties": {
        "public_runtime_affected": {
          "type": "boolean"
        },
        "control_plane_affected": {
          "type": "boolean"
        },
        "satellites": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "freshness_receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "state"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "type": "string",
            "minLength": 1
          },
          "observed_at": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        }
      }
    },
    "project_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "work_summary": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "changed_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "privacy_guard",
        "secret_sweep",
        "docs_pii_guard",
        "supabase_rls_audit"
      ],
      "properties": {
        "privacy_guard": {
          "$ref": "#/$defs/checkState"
        },
        "secret_sweep": {
          "$ref": "#/$defs/checkState"
        },
        "docs_pii_guard": {
          "$ref": "#/$defs/checkState"
        },
        "supabase_rls_audit": {
          "$ref": "#/$defs/checkState"
        },
        "evidence_refs": {
          "type": "array",
          "description": "Pointers to retained verification evidence (commands, logs, receipts).",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "continuation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "targets",
        "priority",
        "resume_checklist"
      ],
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "priority": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "resume_checklist": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "next_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "session_id": {
      "type": "string",
      "description": "Harness/session identity this handoff belongs to. Null until the harness records it.",
      "minLength": 1
    },
    "session_harness": {
      "type": "string",
      "description": "Harness/runtime that produced the session (diagnostic metadata, not a protocol identity).",
      "minLength": 1
    },
    "checkout_id": {
      "type": "string",
      "description": "Checkout ledger identity (TNF-0107) of the checkout this handoff was emitted from.",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "description": "Task/workstream identifier (e.g. TNF-0108) this handoff belongs to.",
      "minLength": 1
    },
    "record_hash": {
      "type": "string",
      "description": "sha256 over the canonical (key-sorted) JSON of this handoff body. Registry rows verify bodies against it.",
      "pattern": "^[0-9a-f]{64}$"
    },
    "turn_status": {
      "type": "string",
      "description": "Emitter-derived: the turn that produced this handoff completed. Never implies task completion.",
      "enum": [
        "turn_complete",
        "turn_incomplete"
      ]
    },
    "task_status": {
      "type": "string",
      "description": "Explicit task-level status. Only a deliberate transition sets task_complete.",
      "enum": [
        "in_progress",
        "task_complete"
      ]
    },
    "acceptance": {
      "type": "object",
      "description": "Acceptance status of the verification claims. Absent means never reviewed; claims keep their evidence regardless of acceptance state.",
      "additionalProperties": false,
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "unverified",
            "claimed",
            "accepted",
            "rejected"
          ]
        },
        "by": {
          "type": "string"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "basis": {
          "type": "string"
        }
      }
    },
    "supersedes": {
      "type": "array",
      "description": "handoff_ids this record explicitly supersedes. Supersession is declared, never implicit last-writer-wins.",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "superseded_by": {
      "type": "string",
      "description": "handoff_id of the record that explicitly supersedes this one.",
      "minLength": 1
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commits": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "deployment_urls": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          },
          "uniqueItems": true
        },
        "database_migrations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "reflection": {
      "type": "object",
      "description": "Turn End reflection (Axiom 5 Persistence, Axiom 8 / D3 Non-Temporal Proliferation): what this session learned, what reusable capability it actualized, what gaps it leaves open, and what the Turn End procedure itself got wrong. Produced by scripts/protocols/turn-end-reflection.cjs. Absent means the question was never asked; explicit \"none\" means it was asked and answered.",
      "additionalProperties": false,
      "required": [
        "lessons",
        "skills"
      ],
      "properties": {
        "lessons": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "considered"
          ],
          "properties": {
            "considered": {
              "type": "boolean"
            },
            "recorded": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "rationale": {
              "type": "string",
              "description": "If nothing was recorded, why not."
            }
          }
        },
        "skills": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "considered"
          ],
          "properties": {
            "considered": {
              "type": "boolean"
            },
            "proposed": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "overlap_reviewed": {
              "type": "boolean"
            },
            "rationale": {
              "type": "string"
            }
          }
        },
        "gaps": {
          "type": "object",
          "description": "Gap analysis for the session: what was found but deliberately not closed. A gap left unrecorded is rediscovered by the next session.",
          "additionalProperties": false,
          "required": [
            "considered"
          ],
          "properties": {
            "considered": {
              "type": "boolean"
            },
            "open": {
              "type": "array",
              "description": "Known-open gaps, each stated so a future session can act on it.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "summary"
                ],
                "properties": {
                  "summary": {
                    "type": "string"
                  },
                  "owner": {
                    "type": "string"
                  },
                  "blocked_on": {
                    "type": "string"
                  },
                  "evidence": {
                    "type": "string"
                  }
                }
              }
            },
            "rationale": {
              "type": "string",
              "description": "If no gaps were recorded, why not."
            }
          }
        },
        "self_audit": {
          "type": "object",
          "description": "Gap analysis of the Turn End procedure itself, computed by the turn. Turn End is the step that decides what the next session inherits, so a defect here is invisible precisely when it matters. Findings are recorded whether or not they are acted on.",
          "additionalProperties": false,
          "required": [
            "checks"
          ],
          "properties": {
            "checks": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "ok"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "ok": {
                    "type": "boolean"
                  },
                  "detail": {
                    "type": "string"
                  }
                }
              }
            },
            "findings": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  },
  "$defs": {
    "checkState": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "na"
      ]
    }
  }
}
