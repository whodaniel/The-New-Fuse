{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thenewfuse.com/schemas/tnf-session-handoff.schema.json",
  "title": "TNF Session Handoff",
  "description": "Canonical machine-readable handoff artifact for repository-aware, capability-first TNF session continuity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec",
    "handoff_id",
    "created_at",
    "repository",
    "repository_context",
    "branch",
    "head_sha",
    "protocol_ack",
    "sensitive_scope",
    "classification",
    "capabilities",
    "publication",
    "freshness_receipts",
    "work_summary",
    "changed_paths",
    "verification",
    "continuation",
    "next_actions"
  ],
  "properties": {
    "spec": {
      "type": "string",
      "const": "tnf/session-handoff/0.2"
    },
    "handoff_id": {
      "type": "string",
      "format": "uuid"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "repository_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_source",
        "actual",
        "publication_targets"
      ],
      "properties": {
        "canonical_source": {
          "type": "string",
          "const": "whodaniel/tnf-monorepo"
        },
        "actual": {
          "type": "string",
          "minLength": 1
        },
        "origin": {
          "type": "string"
        },
        "dirty": {
          "type": "boolean"
        },
        "operation_in_progress": {
          "type": [
            "string",
            "null"
          ]
        },
        "publication_targets": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "whodaniel/The-New-Fuse",
              "whodaniel/fuse-control-plane"
            ]
          },
          "uniqueItems": true
        }
      }
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "head_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "protocol_ack": {
      "type": "string",
      "const": "TNF_PROTOCOL_ACK"
    },
    "sensitive_scope": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "private",
        "restricted"
      ]
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work_domain",
        "artifact_destination",
        "data_residency",
        "sensitivity"
      ],
      "properties": {
        "work_domain": {
          "type": "string",
          "enum": [
            "core",
            "agency",
            "personal",
            "unknown"
          ]
        },
        "artifact_destination": {
          "type": "string",
          "enum": [
            "oss_runtime",
            "public_contract",
            "private_control_plane",
            "satellite",
            "external",
            "unknown"
          ]
        },
        "data_residency": {
          "type": "string",
          "enum": [
            "product_state",
            "bounded_working",
            "external_durable",
            "secret_machine_local",
            "unknown"
          ]
        },
        "sensitivity": {
          "type": "string",
          "enum": [
            "public",
            "internal",
            "private",
            "restricted",
            "unknown"
          ]
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "staffed_by"
      ],
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "staffed_by": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "public_runtime_affected",
        "control_plane_affected",
        "satellites"
      ],
      "properties": {
        "public_runtime_affected": {
          "type": "boolean"
        },
        "control_plane_affected": {
          "type": "boolean"
        },
        "satellites": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "freshness_receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "state"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "type": "string",
            "minLength": 1
          },
          "observed_at": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        }
      }
    },
    "project_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "work_summary": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "changed_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "privacy_guard",
        "secret_sweep",
        "docs_pii_guard",
        "supabase_rls_audit"
      ],
      "properties": {
        "privacy_guard": {
          "$ref": "#/$defs/checkState"
        },
        "secret_sweep": {
          "$ref": "#/$defs/checkState"
        },
        "docs_pii_guard": {
          "$ref": "#/$defs/checkState"
        },
        "supabase_rls_audit": {
          "$ref": "#/$defs/checkState"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "continuation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "targets",
        "priority",
        "resume_checklist"
      ],
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "priority": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "resume_checklist": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "next_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commits": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "deployment_urls": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          },
          "uniqueItems": true
        },
        "database_migrations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "reflection": {
      "type": "object",
      "description": "Turn End reflection (Axiom 5 Persistence, Axiom 8 / D3 Non-Temporal Proliferation): what this session learned, and what reusable capability it actualized. Produced by scripts/protocols/turn-end-reflection.cjs. Absent means the question was never asked; explicit \"none\" means it was asked and answered.",
      "additionalProperties": false,
      "required": [
        "lessons",
        "skills"
      ],
      "properties": {
        "lessons": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "considered"
          ],
          "properties": {
            "considered": {
              "type": "boolean"
            },
            "recorded": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "rationale": {
              "type": "string",
              "description": "If nothing was recorded, why not."
            }
          }
        },
        "skills": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "considered"
          ],
          "properties": {
            "considered": {
              "type": "boolean"
            },
            "proposed": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "overlap_reviewed": {
              "type": "boolean"
            },
            "rationale": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "checkState": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "na"
      ]
    }
  }
}
