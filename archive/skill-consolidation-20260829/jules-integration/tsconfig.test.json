{
  "compilerOptions": {
    "rootDir": ".",
    "module": "CommonJS",
    "target": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "isolatedModules": true,
    "allowJs": true,
    "skipLibCheck": true,
    "types": ["jest", "node"],
    "ignoreDeprecations": "6.0",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  }
}
