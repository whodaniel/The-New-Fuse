#!/usr/bin/env sh
# Prove the commit matches what the operator authorized.
#
# THE GAP THIS CLOSES (proven 2026-08-06)
#   git runs pre-commit, then re-reads the index to build the tree. Anything
#   that stages in that window lands unaudited and unconfirmed. The audit log
#   recorded `commit allowed staged=4` at 18:22:39; the resulting commit carried
#   ~150 files, including docs/legal/DISCLAIMER_DRAFT_FOR_ATTORNEY_REVIEW.md
#   with the operator's full legal name. It was caught only because
#   docs-pii-guard happened to block the later push — luck, not design.
#
#   Several autonomous agents share this working tree, so any broad `git add`
#   races with any commit being composed.
#
# WHY DETECTION AND NOT PREVENTION
#   Git provides no way to hold the index across the pre-commit boundary, and a
#   post-commit hook cannot veto a commit that already exists. What it CAN do is
#   refuse to let the discrepancy be silent: the commit is already local and
#   still unpushed, so the operator can amend or reset before it leaves the
#   machine. Claiming this blocks anything would be the exact defect the audit
#   catalogued — a guard asserting authority it does not have.
#
# Exit is always 0: failing here cannot undo the commit, and a non-zero exit
# would only make `git commit` look like it failed when it did not.

MANIFEST="${TNF_COMMIT_MANIFEST:-${HOME}/.tnf/audit/pending-commit-manifest.txt}"
AUDIT="${TNF_COMMIT_AUDIT_LOG:-${HOME}/.tnf/audit/commit-attempts.jsonl}"

[ -f "$MANIFEST" ] || exit 0

# POSIX sh: no process substitution, so compare via temp files.
TMP_A=$(mktemp) || exit 0
TMP_B=$(mktemp) || exit 0
git show --pretty=format: --name-only HEAD 2>/dev/null | grep -v '^$' | sort >"$TMP_B"
sort "$MANIFEST" 2>/dev/null >"$TMP_A"
rm -f "$MANIFEST" 2>/dev/null || true

if cmp -s "$TMP_A" "$TMP_B"; then
  rm -f "$TMP_A" "$TMP_B"
  exit 0
fi

EXTRA=$(comm -13 "$TMP_A" "$TMP_B" 2>/dev/null)
MISSING=$(comm -23 "$TMP_A" "$TMP_B" 2>/dev/null)
N_AUTH=$(grep -c . "$TMP_A" 2>/dev/null | tr -d ' \n')
N_ACTUAL=$(grep -c . "$TMP_B" 2>/dev/null | tr -d ' \n')
N_EXTRA=$(printf '%s' "$EXTRA" | grep -c . 2>/dev/null | tr -d ' \n')
N_MISSING=$(printf '%s' "$MISSING" | grep -c . 2>/dev/null | tr -d ' \n')
rm -f "$TMP_A" "$TMP_B"
: "${N_EXTRA:=0}" "${N_MISSING:=0}" "${N_AUTH:=0}" "${N_ACTUAL:=0}"

printf '{"ts":"%s","action":"commit-manifest","decision":"MISMATCH","sha":"%s","authorized":%s,"committed":%s,"extra":%s,"missing":%s}\n' \
  "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
  "$(git rev-parse HEAD 2>/dev/null)" \
  "$N_AUTH" "$N_ACTUAL" \
  "$N_EXTRA" "$N_MISSING" \
  >>"$AUDIT" 2>/dev/null || true

echo "" >&2
echo "  ⚠  COMMIT DOES NOT MATCH WHAT WAS AUTHORIZED" >&2
echo "" >&2
echo "  commit:     $(git rev-parse --short HEAD 2>/dev/null)" >&2
echo "  authorized: $N_AUTH path(s) at pre-commit" >&2
echo "  committed:  $N_ACTUAL path(s)" >&2
if [ "$N_EXTRA" -gt 0 ]; then
  echo "" >&2
  echo "  Committed but NOT authorized ($N_EXTRA):" >&2
  printf '%s\n' "$EXTRA" | head -20 | sed 's/^/      /' >&2
  [ "$N_EXTRA" -gt 20 ] && echo "      … and $((N_EXTRA - 20)) more" >&2
fi
[ "$N_MISSING" -gt 0 ] && {
  echo "" >&2
  echo "  Authorized but NOT committed ($N_MISSING):" >&2
  printf '%s\n' "$MISSING" | head -10 | sed 's/^/      /' >&2
}
echo "" >&2
echo "  Something staged files between the authority check and the commit." >&2
echo "  This commit is local and unpushed — review before pushing:" >&2
echo "      git reset --soft HEAD~1 && git reset" >&2
echo "  Then restage deliberately:  git commit -F msg -- <explicit paths>" >&2
echo "" >&2
exit 0
