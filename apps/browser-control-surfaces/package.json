{
  "name": "@tnf/browser-control-surface",
  "version": "2.0.0",
  "description": "TNF Browser Control Surface - Multi-platform AI chat automation with federation integration",
  "type": "module",
  "main": "index.ts",
  "exports": {
    ".": "./index.ts",
    "./components": "./components/index.ts",
    "./hooks": "./hooks/index.ts",
    "./types": "./types/index.ts",
    "./lib": "./lib/harness-protocol.ts"
  },
  "files": [
    "index.ts",
    "BROWSER_CONTROL_SURFACE.tsx",
    "BROWSER_CONTROL_SURFACE.css",
    "components/",
    "hooks/",
    "types/",
    "lib/"
  ],
  "scripts": {
    "build": "tsc",
    "test": "jest --config jest.config.cjs --passWithNoTests",
