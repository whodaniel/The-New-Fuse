{
  "compilerOptions": {
    "moduleResolution": "bundler",
    "target": "es2020",
    "module": "ESNext",
    "outDir": "lib",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "ignoreDeprecations": "6.0"
  }
}
