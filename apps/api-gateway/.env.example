# =============================================================================
# API Gateway Service Environment Configuration
# SECURITY: Never commit actual secrets to version control
# =============================================================================

# Server Configuration
PORT=8080
NODE_ENV=development

# Backend Service URLs
# Update these to match your deployed service URLs in production
# NOTE: 3001 is this gateway's own port — pointing an upstream at it is a
# self-proxy deadlock (see proxy.service.ts's avoidGatewaySelfProxy guard,
# which exists specifically because this file used to say 3001 here). The
# real backend (apps/api, Nest) listens on 3002 locally.
BACKEND_SERVICE_URL=http://localhost:3002
WEBHOOKS_SERVICE_URL=http://localhost:3002
AGENTS_SERVICE_URL=http://localhost:3002
THEIA_IDE_URL=http://localhost:3007

# CORS Origins (comma-separated)
# In production, set to your actual frontend URL(s)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174

# Logging
LOG_LEVEL=debug

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30000

# Build Information (Optional)
npm_package_version=1.0.0