        "scripts/harness/host-compaction-adapter.cjs",
        "data/harness/compaction/",
        "data/harness/host-compaction/"
      ],
      "gap": "Vendor LLM internal token budgets remain opaque; TNF owns manifest-derived hydration receipts, boundary receipts, linked compaction records, and optional transcript import hashes."
    },
    "sandbox_isolation": {
      "status": "partial",
      "evidence": [
        "scripts/forge_sandbox.sb",
        "scripts/harness/materialize-sandbox-profile.cjs",
        "scripts/harness/sandbox-run.cjs",
        "DIRECTIVES.md D11"
      ],
      "gap": "Default interactive Cursor sessions remain unsandboxed by design; untrusted paths must use sandbox-run / berm require_sandbox."
    },
