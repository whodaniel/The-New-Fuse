  "role": "control-plane",
  "definition": "Agent = Model + Harness. TNF is the protocol-neutral control plane; Cursor/Claude/Codex/Gemini/Hermes/OpenClaw and later hosts are capability-provider surfaces.",
  "layers": {
    "interface_override": {
      "status": "implemented",
      "evidence": [
        "docs/protocols/TURN_ZERO_MANDATE.md",
        "docs/core/FRONTLOAD_MANIFEST.md",
        "data/harness/onboarding-contract.json",
        "docs/protocols/HARNESS_AGENT_MODES.md",
        "tnf harness pause|resume"
      ]
    },
    "provider_routing": {
      "status": "implemented",
      "evidence": [
        "scripts/runtime/resolve-harness-context.cjs",
        "data/harness/provider-failover-policy.json",
        "scripts/harness/provider-failover.cjs",
        ".agent/assimilation-routes.json",
        "tnf assimilate"
      ],
      "gap": "Host CLIs may still retry internally; TNF owns the shared failover chain via provider-failover policy, wired into harness-context, model-watchdog, and start-agent-network."
    },
    "context_assembly_compaction": {
      "status": "implemented",
      "evidence": [
        "docs/core/FRONTLOAD_MANIFEST.md",
        "data/harness/onboarding-contract.json",
        "scripts/protocols/frontload-manifest.cjs",
        "scripts/protocols/turn-zero-v2-gate.cjs",
        "scripts/tnf-onboard-twip.cjs",
        "scripts/harness/verify-onboarding-routes.cjs",
