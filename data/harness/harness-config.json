  "injectionSurfaces": {
    "canonical_onboarding": {
      "path": "scripts/tnf-onboard-twip.cjs",
      "mechanism": "pnpm run tnf:onboard derives/hash-receipts Stage A from FRONTLOAD_MANIFEST, verifies required onboarding routes, and emits task-scoped hydration routes",
      "required": true
    },
    "repo_cursor_rules": {
      "path": ".cursor/rules/tnf-harness.mdc",
      "mechanism": "alwaysApply Cursor project pointer to canonical tnf:onboard",
      "required": true
    },
    "repo_claude_md": {
      "path": "CLAUDE.md",
      "mechanism": "Claude Code / compatible project pointer to canonical tnf:onboard",
      "required": true
    },
    "repo_agents_md": {
      "path": "AGENTS.md",
      "mechanism": "AGENTS.md industry-standard project surface; canonical Stage A still comes from FRONTLOAD_MANIFEST",
      "required": true
    },
    "global_frontload_installer": {
      "path": "scripts/install-agent-frontload.cjs",
      "mechanism": "fenced TNF-FRONTLOAD pointers into empirically verified host context files; pointers invoke canonical tnf:onboard rather than duplicating rails",
      "required": true
    },
    "openclaw_workspace": {
      "path": "~/.openclaw/workspace",
      "mechanism": "OpenClaw injects workspace bootstrap md into Project Context",
      "required": false,
      "managedFiles": [
        "AGENTS.md",
        "SOUL.md",
        "IDENTITY.md",
        "USER.md",
        "TOOLS.md",
        "HEARTBEAT.md",
        "MEMORY.md",
        "BOOTSTRAP.md"
      ],
      "policy": "pointer-or-symlink-to-docs/core; never silent overwrite of operator-authored SOUL without backup"
    },
    "hermes_soul": {
      "path": "~/.hermes/SOUL.md",
      "mechanism": "global Hermes identity (via install-agent-frontload)",
      "required": false
    },
    "zcode_agents_md": {
      "path": "~/.zcode/AGENTS.md",
      "mechanism": "ZCode (dev.zcode.app) user-scope instruction file, injected first in every session with workspace AGENTS.md loaded later; managed fenced pointer via install-agent-frontload; first materialization requires --include-unverified because a fresh ZCode install never creates the file",
      "required": false
    }
  },
  "patterns": [
    "bounded_iteration",
    "controlled_writes",
    "two_stage_compaction_records",
    "persist_large_tool_outputs",
    "resumable_sessions",
    "trajectory_retention",
    "scoped_tool_permissions",
    "lifecycle_hooks",
    "provider_abstraction",
    "progressive_disclosure",
    "manifest_derived_stage_a",
    "proof_bearing_hydration",
    "task_scoped_context",
    "required_task_route_integrity",
    "do_not_reinvent",
    "concurrent_workstream_collision_boundaries"
  ],
  "verify": {
    "commands": [
      "node scripts/protocols/frontload-manifest.cjs --stage A --json",
      "node --test scripts/protocols/frontload-manifest.test.cjs",
      "node --test scripts/protocols/turn-zero-v2-gate.test.cjs",
