#!/usr/bin/env bash
set -euo pipefail

# Resolve REAL location even when called via symlink
THIS=$(readlink -f "$0" 2>/dev/null || greadlink -f "$0" 2>/dev/null || echo "$0")
ROOT_DIR="$(cd "$(dirname "${THIS}")" && pwd)"

# Use pnpm --prefix to ensure we find the correct workspace even if called from elsewhere
exec pnpm --prefix "$ROOT_DIR" exec tsx "$ROOT_DIR/packages/tnf-cli/src/cli.ts" "$@"
