{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "cases", "triggers"],
  "properties": {
    "version": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "arguments", "expected_exit", "expected_stdout"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "arguments": {
            "type": "object",
            "maxProperties": 32,
            "propertyNames": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "boolean"
                }
              ]
            }
          },
          "expected_exit": {
            "type": "integer",
            "minimum": 0,
            "maximum": 125
          },
          "expected_stdout": {
            "type": "string",
            "maxLength": 8192
          }
        }
      },
      "minItems": 2,
      "maxItems": 32
    },
    "triggers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "activate"],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "activate": {
            "type": "boolean"
          }
        }
      },
      "minItems": 2,
      "maxItems": 32
    }
  }
}
