{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "action",
    "request_id",
    "skill_name",
    "lineage",
    "triggers",
    "skill_markdown",
    "artifact",
    "evals",
    "assertions"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "action": {
      "const": "synthesize"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "skill_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "lineage": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "minItems": 0,
      "maxItems": 3
    },
    "triggers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["positive", "negative"],
      "properties": {
        "positive": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "minItems": 1,
          "maxItems": 16
        },
        "negative": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "minItems": 1,
          "maxItems": 16
        }
      }
    },
    "skill_markdown": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32000
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "source", "arguments_schema", "tools"],
      "properties": {
        "language": {
          "const": "python-pep723"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "arguments_schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "additionalProperties",
            "required",
            "properties"
          ],
          "properties": {
            "type": {
              "const": "object"
            },
            "additionalProperties": {
              "const": false
            },
            "required": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "minItems": 0,
              "maxItems": 32
            },
            "properties": {
              "type": "object",
              "minProperties": 1,
              "maxProperties": 32,
              "propertyNames": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": ["type"],
                "properties": {
                  "type": {
                    "enum": ["string", "integer", "boolean"]
                  }
                }
              }
            }
          }
        },
        "tools": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "evals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "cases", "triggers"],
      "properties": {
        "version": {
          "const": 1
        },
        "cases": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "arguments", "expected_exit", "expected_stdout"],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "arguments": {
                "type": "object",
                "maxProperties": 32,
                "propertyNames": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "integer"
                    },
                    {
                      "type": "boolean"
                    }
                  ]
                }
              },
              "expected_exit": {
                "type": "integer",
                "minimum": 0,
                "maximum": 125
              },
              "expected_stdout": {
                "type": "string",
                "maxLength": 8192
              }
            }
          },
          "minItems": 2,
          "maxItems": 32
        },
        "triggers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text", "activate"],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "activate": {
                "type": "boolean"
              }
            }
          },
          "minItems": 2,
          "maxItems": 32
        }
      }
    },
    "assertions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "require_help",
        "require_repeatability",
        "network",
        "max_stdout_bytes",
        "case_timeout_seconds"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "require_help": {
          "const": true
        },
        "require_repeatability": {
          "const": true
        },
        "network": {
          "const": "none"
        },
        "max_stdout_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        },
        "case_timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        }
      }
    }
  }
}
