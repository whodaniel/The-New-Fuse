# Exclude everything by default, then re-include what's needed
# Must re-include parent dirs for nested re-includes to work
*
!apps/
!apps/api/
!packages/
!packages/a2a-core/
!packages/api-types/
!packages/core/
!packages/database/
!packages/infrastructure/
!packages/jules-skill/
!packages/n8n-workflows/
!packages/port-management/
!packages/relay-core/
!packages/workflow-engine/
!packages/types/
!packages/utils/
!packages/web-scraping/
# Essential root files
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!tsconfig.base.json
!.npmrc
!Dockerfile.api
!cloudbuild-api.yaml
# Exclude node_modules and dist from all (these get rebuilt in Docker)
**/node_modules/
**/dist/
**/*.test.ts
**/*.spec.ts
**/test/
**/tests/
**/__tests__/
**/coverage/
