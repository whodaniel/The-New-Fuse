# Exclude everything by default, then re-include what's needed
# Must re-include parent dirs for nested re-includes to work
*
!apps/
apps/*
!apps/api/
!apps/api/**
!apps/api-gateway/
!apps/api-gateway/**
!packages/
packages/*
!packages/a2a-core/
!packages/a2a-core/**
!packages/agent/
!packages/agent/**
!packages/ap2-protocol/
!packages/ap2-protocol/**
!packages/api-types/
!packages/api-types/**
!packages/core/
!packages/core/**
!packages/core-error-handling/
!packages/core-error-handling/**
!packages/core-monitoring/
!packages/core-monitoring/**
!packages/core-vector-db/
!packages/core-vector-db/**
!packages/database/
!packages/database/**
!packages/eslint-config-custom/
!packages/eslint-config-custom/**
!packages/fairtable-adapters/
!packages/fairtable-adapters/**
!packages/fairtable-components/
!packages/fairtable-components/**
!packages/fairtable-core/
!packages/fairtable-core/**
!packages/fairtable-utils/
!packages/fairtable-utils/**
!packages/infrastructure/
!packages/infrastructure/**
!packages/coding-agent-delegation/
!packages/coding-agent-delegation/**
# Depended on as workspace:* by api-gateway/frontend/extensions. Without this
# re-include the tarball ships a packages/ tree missing it, and the workspace
# link resolves to nothing inside the image.
!packages/llm-catalog/
!packages/llm-catalog/**
!packages/mcp-core/
!packages/mcp-core/**
!packages/n8n-workflows/
!packages/n8n-workflows/**
!packages/port-management/
!packages/port-management/**
!packages/proto-definitions/
!packages/proto-definitions/**
!packages/protocol-contracts/
!packages/protocol-contracts/**
!packages/relay-core/
!packages/relay-core/**
!packages/security/
!packages/security/**
!packages/shared/
!packages/shared/**
!packages/tnf-browser/
!packages/tnf-browser/**
!packages/tnf-cli/
!packages/tnf-cli/**
!packages/tnf-core/
!packages/tnf-core/**
!packages/tnf-note-taking/
!packages/tnf-note-taking/**
!packages/workflow-engine/
!packages/workflow-engine/**
!packages/types/
!packages/types/**
!packages/utils/
!packages/utils/**
!packages/web-scraping/
!packages/web-scraping/**
# Essential root files
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!tsconfig.base.json
!.npmrc
# Required by any --frozen-lockfile install: the lockfile pins pnpmfileChecksum.
!.pnpmfile.cjs
# COPYed by scripts/deployment/Dockerfile.api-gateway; a missing source makes
# the COPY itself fail, before any install runs.
!tsconfig.json
!tsconfig.standard.json
!turbo.json
!Dockerfile.api
!Dockerfile.api-gateway
!cloudbuild-api.yaml
!scripts/
!scripts/**
!scripts/deployment/cloudbuild.gateway.yaml
# Packaged stock banks for Library (Cloud Run fallback when FS banks slim)
!data/
!data/agent-bank/
!data/agent-bank/**
# Runtime bank sources scanned by AgentBankService / Dockerfile.api.
# Only .agent/agents/** is actually needed at runtime; a bare `!.agent/`
# re-include (as this used to be) drags in the entire directory — 294MB of
# docs, skill-bank snapshots, and volatile scratch dirs like test-reports/
# that other agent processes write to concurrently in this shared checkout,
# which both bloats every upload and can crash mid-tar when a file it's
# reading gets deleted out from under it. Exclude every direct child of
# .agent/ by default, then re-include only the one subtree that's used.
!.agent/
.agent/*
!.agent/agents/
!.agent/agents/**
!.claude/
!.claude/agents/
!.claude/agents/**
# Exclude node_modules and dist from all (these get rebuilt in Docker)
**/node_modules/
**/*.test.ts
**/*.spec.ts
**/test/
**/tests/
**/__tests__/
**/coverage/
