# Ignore unrelated Go packages that confuse Cloud Run Buildpacks
**/cmd
**/pkg
**/*.go
**/go.mod
**/go.sum

# Standard ignores
node_modules
dist
build
.git
.kilo
reports
temp

# Prevent stale TypeScript build artifacts from entering Docker context
# (these confuse tsc -b incremental compilation)
# BUT allow generated protobuf/js files that are source, not build output
packages/*/src/**/*.js
!packages/*/src/generated/**/*.js
!packages/*/src/generated/**/*.d.ts
packages/*/src/**/*.js.map
packages/*/src/**/*.d.ts
!packages/*/src/generated/**/*.d.ts
packages/*/src/**/*.d.ts.map
packages/*/tsconfig.tsbuildinfo
